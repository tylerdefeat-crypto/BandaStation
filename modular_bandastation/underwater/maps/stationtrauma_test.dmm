/obj/item/paper{
	name = "Водяной контур";
	default_raw_text = "Резервуар содержит 500 л воды при 40 C. Откройте клапан и включите выпуск ЛКМ: вода появится на полу выпуска. Трубная помпа на западе собирает воду с пола в буфер. Полный буфер и закрытый клапан останавливают поток. Осмотр пола и оборудования показывает температуру. Ключ разбирает обычную трубу TG; запас труб рядом. В этом контуре 1u соответствует 1 л, 1 см глубины — 10 л на клетке. Газовое охлаждение реактора — отдельный контур."
	},
